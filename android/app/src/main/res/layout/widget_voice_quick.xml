<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 1: Google Pixel Search & Voice Quick Bar (4x1 / 4x2 Resizable Material 3) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_m3_surface"
    android:clipToOutline="true">

    <LinearLayout
        android:id="@+id/widget_voice_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingTop="8dp"
        android:paddingRight="10dp"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="LifeOS"
            android:src="@drawable/ic_widget_leaf" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_m3_tonal_box"
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingTop="6dp"
            android:paddingRight="12dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/tv_voice_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Nói chi tiêu hoặc chia tiền..."
                android:textColor="@color/widget_text_primary"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/tv_voice_today_spend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Chi hôm nay: 0 ₫"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10.5sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btn_widget_voice_mic"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_widget_m3_primary_pill">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="Nói ghi chi tiêu"
                android:src="@drawable/ic_widget_mic" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_widget_voice_split"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginLeft="6dp"
            android:background="@drawable/bg_widget_m3_tonal_pill">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="Chia tiền nhóm"
                android:src="@drawable/ic_widget_split" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
