<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 2: Interactive On-Home-Screen Net Worth & Cashflow Card (4x2 Material 3) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_m3_surface"
    android:clipToOutline="true">

    <LinearLayout
        android:id="@+id/widget_wealth_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="13dp">

        <!-- Header: Leaf opens app if needed; Mode pill & Mask pill work right on Home Screen via Broadcast -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/img_wealth_open_app"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="LifeOS"
                android:src="@drawable/ic_widget_leaf" />

            <TextView
                android:id="@+id/tv_wealth_mode_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Tổng tài sản ròng"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/btn_wealth_toggle_mask"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:background="@drawable/bg_widget_m3_tonal_box"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:text="Ẩn số"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tv_wealth_badge"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginLeft="5dp"
                android:background="@drawable/bg_widget_m3_tonal_pill"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:text="Đổi góc nhìn"
                android:textColor="@color/widget_primary_tonal_fg"
                android:textSize="10sp" />

            <FrameLayout
                android:id="@+id/btn_wealth_quick_add"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginLeft="5dp"
                android:background="@drawable/bg_widget_m3_primary_pill">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="center"
                    android:contentDescription="Ghi thu chi nổi ngoài màn hình"
                    android:src="@drawable/ic_widget_add" />
            </FrameLayout>
        </LinearLayout>

        <!-- Tappable Headline Metric (Cycles Net Worth / Monthly Net / Today Spend right on Home Screen) -->
        <TextView
            android:id="@+id/tv_wealth_net_worth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="80.100.000 ₫"
            android:textColor="@color/widget_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Concentric Inner Tonal KPI Pills (Tap to log quick income/expense via floating overlay) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:gravity="bottom"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/box_wealth_income"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_widget_m3_income_box"
                android:orientation="vertical"
                android:paddingLeft="10dp"
                android:paddingTop="5dp"
                android:paddingRight="10dp"
                android:paddingBottom="5dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thu tháng (+Ghi)"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="9.8sp" />

                <TextView
                    android:id="@+id/tv_wealth_income"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="+25.700.000 ₫"
                    android:textColor="@color/widget_text_income"
                    android:textSize="11.8sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/box_wealth_expense"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_widget_m3_expense_box"
                android:orientation="vertical"
                android:paddingLeft="10dp"
                android:paddingTop="5dp"
                android:paddingRight="10dp"
                android:paddingBottom="5dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chi tháng (+Ghi)"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="9.8sp" />

                <TextView
                    android:id="@+id/tv_wealth_expense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="-1.573.000 ₫"
                    android:textColor="@color/widget_text_expense"
                    android:textSize="11.8sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
