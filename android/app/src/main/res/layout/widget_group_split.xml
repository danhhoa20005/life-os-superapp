<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 3: Interactive On-Home-Screen Family & Roommate Split Card (4x2 Material 3) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_m3_surface"
    android:clipToOutline="true">

    <LinearLayout
        android:id="@+id/widget_group_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="13dp">

        <!-- Header + On-Home-Screen Member Count Stepper (- / N nguoi / +) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/img_group_open_app"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Tổ ấm &amp; Hội nhóm"
                android:src="@drawable/ic_widget_leaf" />

            <TextView
                android:id="@+id/tv_group_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Tổ ấm &amp; Hội nhóm"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/btn_group_minus"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/bg_widget_m3_tonal_box"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="-"
                android:textColor="@color/widget_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_group_members"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:text="3 người"
                android:textColor="@color/widget_text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_group_plus"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/bg_widget_m3_tonal_pill"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="+"
                android:textColor="@color/widget_primary_tonal_fg"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Live Per-Person Calculation Result directly on Home Screen -->
        <TextView
            android:id="@+id/tv_group_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:text="Chọn số người rồi chạm mức chia nhanh bên dưới"
            android:textColor="@color/widget_text_primary"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <!-- Direct 1-Tap Broadcast Split Pills + Floating Voice Split -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_group_split_150k"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/bg_widget_m3_tonal_pill"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:text="+Ăn 150k"
                android:textColor="@color/widget_primary_tonal_fg"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_group_split_300k"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginLeft="6dp"
                android:layout_weight="1.15"
                android:background="@drawable/bg_widget_m3_tonal_pill"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:text="+Hóa đơn 300k"
                android:textColor="@color/widget_primary_tonal_fg"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/btn_group_voice_split"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginLeft="6dp"
                android:layout_weight="1.1"
                android:background="@drawable/bg_widget_m3_primary_pill"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingLeft="8dp"
                android:paddingRight="8dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:contentDescription="Mic"
                    android:src="@drawable/ic_widget_mic" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="Nói chia"
                    android:textColor="@color/widget_on_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
