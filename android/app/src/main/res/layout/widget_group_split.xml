<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_group_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_cobalt"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/tv_group_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="HỘI NHÓM &amp; GIA ĐÌNH · CHIA TIỀN NHANH"
        android:textColor="#BAE6FD"
        android:textSize="10.5sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_group_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Sẵn sàng chia ăn uống, việc nhà, điện nước"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_group_voice_split"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1.35"
            android:background="@drawable/bg_widget_pill_mint"
            android:gravity="center"
            android:text="🎙 Nói câu chia tiền"
            android:textColor="#FFFFFF"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_group_vietqr"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_pill_glass"
            android:gravity="center"
            android:text="QR Tất toán"
            android:textColor="#FFFFFF"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
