rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAccountFrozenForDeletion(userId) {
      return exists(/databases/$(database)/documents/account_deletion_tombstones/$(userId));
    }

    function isActiveOwner(userId) {
      return isOwner(userId) && !isAccountFrozenForDeletion(userId);
    }

    function isAccountDeletionActive(userId) {
      return isOwner(userId)
        && !isAccountFrozenForDeletion(userId)
        && exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.deletionInProgress == true;
    }

    function isPositiveInt(val) {
      return val is int && val > 0;
    }

    function isTxVerified(data) {
      return (data.get('verification', '') is string && data.get('verification', '').lower() in ['verified', 'verifiedbybank', 'verified_by_bank'])
        || (data.get('verificationStatus', '') is string && data.get('verificationStatus', '').lower() in ['verified', 'verifiedbybank', 'verified_by_bank']);
    }

    function isVerifiedByBankField(val) {
      return val is string && val.lower() in ['verified', 'verifiedbybank', 'verified_by_bank'];
    }

    function isClientAllowedTxVerification(v) {
      return v is string && v in ['provisional', 'userConfirmed', 'matchedPaymentOrder', 'needsReview', 'rejected'];
    }

    function isClientAllowedTxVerificationStatus(vs) {
      return vs is string && vs in ['PROVISIONAL', 'USER_CONFIRMED', 'NEEDS_REVIEW', 'REJECTED', 'MATCHED_PAYMENT_ORDER'];
    }

    function isClientAllowedTxSourceKind(s) {
      return s is string && s in ['manual', 'csv', 'androidNotification', 'aiDraft'];
    }

    function isServerSourceEventName(s) {
      return s is string && s.lower() in ['sepay_webhook', 'sepay_api', 'bank_webhook', 'bank_api'];
    }

    function isTxReversed(data) {
      return data.get('verificationStatus', '') is string
        && data.get('verificationStatus', '').lower() == 'reversed';
    }

    function familyDoc(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId));
    }

    function isFamilyMember(familyId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/families/$(familyId))
        && request.auth.uid in familyDoc(familyId).data.memberIds;
    }

    function isFamilyManager(familyId) {
      return isFamilyMember(familyId)
        && (
          familyDoc(familyId).data.memberRoles[request.auth.uid] == 'owner'
          || familyDoc(familyId).data.memberRoles[request.auth.uid] == 'admin'
        );
    }

    function unchangedMapExceptSelfJoin(oldMap, newMap, uid) {
      return newMap.diff(oldMap).removedKeys().size() == 0
        && newMap.diff(oldMap).changedKeys().size() == 0
        && newMap.diff(oldMap).addedKeys().hasOnly([uid]);
    }

    function unchangedMapExceptSelfLeave(oldMap, newMap, uid) {
      return newMap.diff(oldMap).addedKeys().size() == 0
        && newMap.diff(oldMap).changedKeys().size() == 0
        && newMap.diff(oldMap).removedKeys().hasOnly([uid]);
    }

    function hasNonEmptyString(data, field) {
      return field in data && data[field] is string && data[field].size() > 0;
    }

    function isTargetedInvite(invData) {
      return invData.get('inviteKind', '') == 'targeted'
        || invData.get('isTargeted', false) == true
        || hasNonEmptyString(invData, 'inviteeUid')
        || hasNonEmptyString(invData, 'inviteeEmail')
        || hasNonEmptyString(invData, 'intendedRecipientHash');
    }

    function tokenEmailMatches(expectedEmail) {
      return 'email_verified' in request.auth.token
        && request.auth.token.email_verified == true
        && 'email' in request.auth.token
        && request.auth.token.email is string
        && request.auth.token.email.trim().lower() == expectedEmail.trim().lower();
    }

    function sha256HexLower(text) {
      return hashing.sha256(text.toUtf8()).toHexString().lower();
    }

    function tokenMatchesRecipientHash(targetHash) {
      return (
        sha256HexLower(request.auth.uid) == targetHash.lower()
      ) || (
        'email_verified' in request.auth.token
        && request.auth.token.email_verified == true
        && 'email' in request.auth.token
        && request.auth.token.email is string
        && request.auth.token.email.trim().size() > 0
        && sha256HexLower(request.auth.token.email.trim().lower()) == targetHash.lower()
      ) || (
        'phone_number' in request.auth.token
        && request.auth.token.phone_number is string
        && request.auth.token.phone_number.trim().size() > 0
        && (
          sha256HexLower(request.auth.token.phone_number.trim().lower()) == targetHash.lower()
          || (
            request.auth.token.phone_number.matches('^\\+84[0-9]{8,11}$')
            && sha256HexLower('0' + request.auth.token.phone_number[3:request.auth.token.phone_number.size()]) == targetHash.lower()
          )
        )
      );
    }

    function isAuthorizedForInvite(invData) {
      return !isTargetedInvite(invData)
        || (
          hasNonEmptyString(invData, 'inviteeUid')
            ? request.auth.uid == invData.inviteeUid
            : (
              hasNonEmptyString(invData, 'inviteeEmail')
                ? tokenEmailMatches(invData.inviteeEmail)
                : (
                  hasNonEmptyString(invData, 'intendedRecipientHash')
                    && tokenMatchesRecipientHash(invData.intendedRecipientHash)
                )
            )
        );
    }

    // Bounded share validation helper (max 20 participants per split bill; Firestore Rules disallow loops)
    function isValidShareAt(vals, idx) {
      return vals.size() <= idx || (vals[idx] is int && vals[idx] >= 0);
    }

    function allSharesNonNegativeInts(vals) {
      return vals.size() >= 1
        && vals.size() <= 20
        && isValidShareAt(vals, 0)
        && isValidShareAt(vals, 1)
        && isValidShareAt(vals, 2)
        && isValidShareAt(vals, 3)
        && isValidShareAt(vals, 4)
        && isValidShareAt(vals, 5)
        && isValidShareAt(vals, 6)
        && isValidShareAt(vals, 7)
        && isValidShareAt(vals, 8)
        && isValidShareAt(vals, 9)
        && isValidShareAt(vals, 10)
        && isValidShareAt(vals, 11)
        && isValidShareAt(vals, 12)
        && isValidShareAt(vals, 13)
        && isValidShareAt(vals, 14)
        && isValidShareAt(vals, 15)
        && isValidShareAt(vals, 16)
        && isValidShareAt(vals, 17)
        && isValidShareAt(vals, 18)
        && isValidShareAt(vals, 19);
    }

    function shareAtOrZero(vals, idx) {
      return vals.size() > idx ? vals[idx] : 0;
    }

    function sumUpTo20Shares(vals) {
      return shareAtOrZero(vals, 0)
        + shareAtOrZero(vals, 1)
        + shareAtOrZero(vals, 2)
        + shareAtOrZero(vals, 3)
        + shareAtOrZero(vals, 4)
        + shareAtOrZero(vals, 5)
        + shareAtOrZero(vals, 6)
        + shareAtOrZero(vals, 7)
        + shareAtOrZero(vals, 8)
        + shareAtOrZero(vals, 9)
        + shareAtOrZero(vals, 10)
        + shareAtOrZero(vals, 11)
        + shareAtOrZero(vals, 12)
        + shareAtOrZero(vals, 13)
        + shareAtOrZero(vals, 14)
        + shareAtOrZero(vals, 15)
        + shareAtOrZero(vals, 16)
        + shareAtOrZero(vals, 17)
        + shareAtOrZero(vals, 18)
        + shareAtOrZero(vals, 19);
    }

    function hasValidSplitBillShares(data, familyId) {
      return data.sharesByUserId is map
        && data.sharesByUserId.size() >= 1
        && data.sharesByUserId.size() <= 20
        && familyDoc(familyId).data.memberIds.hasAll(data.sharesByUserId.keys())
        && allSharesNonNegativeInts(data.sharesByUserId.values())
        && sumUpTo20Shares(data.sharesByUserId.values()) == data.totalAmountMinor;
    }

    // =========================================================================
    // 1. PERSONAL USER SPACE — STRICT OWNER ISOLATION (NO FAMILY ADMIN ACCESS!)
    // =========================================================================
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isActiveOwner(userId)
        && request.resource.data.id == userId
        && !('password' in request.resource.data);
      allow update: if isActiveOwner(userId)
        && request.resource.data.id == resource.data.id
        && !('password' in request.resource.data)
        && (
          resource.data.get('deletionInProgress', false) != true
          || request.resource.data.get('deletionInProgress', false) == true
        );
      allow delete: if false;

      match /wallets/{walletId} {
        allow read: if isOwner(userId);
        allow create: if isActiveOwner(userId)
          && request.resource.data.ownerId == userId
          && request.resource.data.balanceMinor is int;
        // F06 / Section 40 / AUD-010: Balance updates must preserve identity, carry timestamp,
        // and prove a brand-new atomic ledger_audit entry with exact balance math!
        allow update: if isActiveOwner(userId)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.get('id', walletId) == resource.data.get('id', walletId)
          && request.resource.data.balanceMinor is int
          && (
            request.resource.data.balanceMinor == resource.data.balanceMinor
            || (
              'updatedAt' in request.resource.data
              && request.resource.data.updatedAt is timestamp
              && 'lastAuditId' in request.resource.data
              && request.resource.data.lastAuditId is string
              && request.resource.data.lastAuditId.size() > 0
              && !exists(/databases/$(database)/documents/users/$(userId)/ledger_audits/$(request.resource.data.lastAuditId))
              && existsAfter(/databases/$(database)/documents/users/$(userId)/ledger_audits/$(request.resource.data.lastAuditId))
              && getAfter(/databases/$(database)/documents/users/$(userId)/ledger_audits/$(request.resource.data.lastAuditId)).data.previousBalanceMinor == resource.data.balanceMinor
              && getAfter(/databases/$(database)/documents/users/$(userId)/ledger_audits/$(request.resource.data.lastAuditId)).data.newBalanceMinor == request.resource.data.balanceMinor
              && getAfter(/databases/$(database)/documents/users/$(userId)/ledger_audits/$(request.resource.data.lastAuditId)).data.previousBalanceMinor
                + getAfter(/databases/$(database)/documents/users/$(userId)/ledger_audits/$(request.resource.data.lastAuditId)).data.deltaMinor
                == getAfter(/databases/$(database)/documents/users/$(userId)/ledger_audits/$(request.resource.data.lastAuditId)).data.newBalanceMinor
            )
          );
        allow delete: if isActiveOwner(userId)
          && !(resource.data.get('linkedBankConnectionId', '') is string && resource.data.get('linkedBankConnectionId', '').size() > 0)
          && !(resource.data.get('archived', false) == false && resource.data.get('hasTransactions', false) == true);
      }

      // IMMUTABLE DOUBLE-ENTRY WALLET AUDIT TRAIL (APPEND-ONLY BANKING PASSBOOK)
      match /ledger_audits/{auditId} {
        allow read: if isOwner(userId);
        allow create: if isActiveOwner(userId)
          && request.resource.data.ownerId == userId
          && request.resource.data.get('txId', '') is string
          && request.resource.data.get('txId', '').size() > 0
          && request.resource.data.get('walletId', '') is string
          && request.resource.data.get('walletId', '').size() > 0
          && request.resource.data.previousBalanceMinor is int
          && request.resource.data.deltaMinor is int
          && request.resource.data.newBalanceMinor is int
          && request.resource.data.previousBalanceMinor + request.resource.data.deltaMinor == request.resource.data.newBalanceMinor;
        allow update, delete: if false;
      }

      // MONTHLY NET WORTH & CASHFLOW SNAPSHOTS FOR HISTORICAL WEALTH ANALYTICS
      match /net_worth_snapshots/{monthKey} {
        allow read: if isOwner(userId);
        allow create, update: if isActiveOwner(userId)
          && request.resource.data.ownerId == userId
          && request.resource.data.netWorthMinor is int;
        allow delete: if isAccountDeletionActive(userId);
      }

      // MONTHLY AGGREGATED FINANCIAL SUMMARIES (FIX-001: Unbounded monthly rollup cache)
      match /monthly_summaries/{monthKey} {
        allow read: if isOwner(userId);
        allow create, update: if isActiveOwner(userId);
        allow delete: if isAccountDeletionActive(userId);
      }

      // SMART AUTOMATION ENGINE RULES & IMMUTABLE AUDIT LOGS (Section 20)
      match /automation_rules/{ruleId} {
        allow read: if isOwner(userId);
        allow write: if isActiveOwner(userId);
      }

      match /automation_audits/{auditId} {
        allow read: if isOwner(userId);
        allow create: if isActiveOwner(userId);
        allow update, delete: if false;
      }

      match /categories/{categoryId} {
        allow read: if isOwner(userId);
        allow write: if isActiveOwner(userId);
      }

      match /transactions/{txId} {
        allow read: if isOwner(userId);
        allow create: if isActiveOwner(userId)
          && request.resource.data.ownerId == userId
          && isPositiveInt(request.resource.data.amountMinor)
          && request.resource.data.currencyCode == 'VND'
          && isClientAllowedTxVerification(request.resource.data.get('verification', null))
          && (
            !('verificationStatus' in request.resource.data)
            || isClientAllowedTxVerificationStatus(request.resource.data.verificationStatus)
          )
          && isClientAllowedTxSourceKind(request.resource.data.get('sourceKind', null));
        allow update: if isActiveOwner(userId)
          && request.resource.data.ownerId == resource.data.ownerId
          && isPositiveInt(request.resource.data.amountMinor)
          && (
            !isTxReversed(resource.data)
            || (
              request.resource.data.get('verificationStatus', null) == resource.data.get('verificationStatus', null)
              && request.resource.data.get('reversedById', null) == resource.data.get('reversedById', null)
              && request.resource.data.amountMinor == resource.data.amountMinor
              && request.resource.data.get('walletId', null) == resource.data.get('walletId', null)
              && request.resource.data.get('kind', null) == resource.data.get('kind', null)
              && request.resource.data.get('direction', null) == resource.data.get('direction', null)
              && request.resource.data.get('currencyCode', null) == resource.data.get('currencyCode', null)
              && request.resource.data.get('currency', null) == resource.data.get('currency', null)
              && request.resource.data.get('isRefund', null) == resource.data.get('isRefund', null)
              && request.resource.data.get('occurredAt', null) == resource.data.get('occurredAt', null)
              && request.resource.data.get('monthKey', null) == resource.data.get('monthKey', null)
              && request.resource.data.get('balanceAfterMinor', null) == resource.data.get('balanceAfterMinor', null)
              && request.resource.data.get('splitLines', null) == resource.data.get('splitLines', null)
            )
          )
          && (
            (
              (isTxVerified(resource.data) || resource.data.get('sourceKind', '') in ['bankWebhook', 'bankApi'])
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['categoryId', 'categoryName', 'merchant', 'note', 'updatedAt'])
              && request.resource.data.get('verification', null) == resource.data.get('verification', null)
              && request.resource.data.get('verificationStatus', null) == resource.data.get('verificationStatus', null)
              && request.resource.data.get('sourceKind', null) == resource.data.get('sourceKind', null)
              && request.resource.data.amountMinor == resource.data.amountMinor
              && request.resource.data.get('direction', null) == resource.data.get('direction', null)
              && request.resource.data.get('walletId', null) == resource.data.get('walletId', null)
              && request.resource.data.get('currency', null) == resource.data.get('currency', null)
              && request.resource.data.get('currencyCode', null) == resource.data.get('currencyCode', null)
              && request.resource.data.get('kind', null) == resource.data.get('kind', null)
              && request.resource.data.get('externalTransactionId', null) == resource.data.get('externalTransactionId', null)
              && request.resource.data.get('referenceCode', null) == resource.data.get('referenceCode', null)
              && request.resource.data.get('observedBalanceMinor', null) == resource.data.get('observedBalanceMinor', null)
              && request.resource.data.get('occurredAt', null) == resource.data.get('occurredAt', null)
              && request.resource.data.get('monthKey', null) == resource.data.get('monthKey', null)
              && request.resource.data.get('balanceAfterMinor', null) == resource.data.get('balanceAfterMinor', null)
              && request.resource.data.get('splitLines', null) == resource.data.get('splitLines', null)
              && request.resource.data.get('isRefund', null) == resource.data.get('isRefund', null)
              && request.resource.data.get('ledgerApplied', null) == resource.data.get('ledgerApplied', null)
            )
            || (
              !(isTxVerified(resource.data) || resource.data.get('sourceKind', '') in ['bankWebhook', 'bankApi'])
              && (!('verification' in request.resource.data) || isClientAllowedTxVerification(request.resource.data.verification))
              && (!('verification' in resource.data) || isClientAllowedTxVerification(request.resource.data.get('verification', null)))
              && (
                !('verificationStatus' in request.resource.data)
                || isClientAllowedTxVerificationStatus(request.resource.data.verificationStatus)
                || (
                  request.resource.data.verificationStatus == 'REVERSED'
                  && 'reversedById' in request.resource.data
                  && request.resource.data.reversedById is string
                  && request.resource.data.reversedById.size() > 0
                )
              )
              && (!('sourceKind' in request.resource.data) || isClientAllowedTxSourceKind(request.resource.data.sourceKind))
              && (!('sourceKind' in resource.data) || isClientAllowedTxSourceKind(request.resource.data.get('sourceKind', null)))
            )
          );
        // Immutable during normal operation; purged cleanly only during verified right-to-erasure account deletion
        allow delete: if isAccountDeletionActive(userId);
      }

      match /budgets/{budgetId} {
        allow read: if isOwner(userId);
        allow create, update: if isActiveOwner(userId)
          && request.resource.data.ownerId == userId
          && isPositiveInt(request.resource.data.limitMinor);
        allow delete: if isActiveOwner(userId);
      }

      match /personal_funds/{fundId} {
        allow read: if isOwner(userId);
        allow write: if isActiveOwner(userId);

        match /contributions/{contribId} {
          allow read: if isOwner(userId);
          allow create: if isActiveOwner(userId)
            && isPositiveInt(request.resource.data.amountMinor);
          allow delete: if isAccountDeletionActive(userId);
        }

        match /expenses/{expId} {
          allow read: if isOwner(userId);
          allow create, update: if isActiveOwner(userId)
            && isPositiveInt(request.resource.data.amountMinor);
          allow delete: if isAccountDeletionActive(userId);
        }

        match /fund_audits/{auditId} {
          allow read: if isOwner(userId);
          allow create, delete: if isActiveOwner(userId);
          allow update: if false;
        }
      }

      // PRIVATE CALENDAR — Family Owners/Admins NEVER have access!
      match /calendars/{calId} {
        allow read: if isOwner(userId);
        allow write: if isActiveOwner(userId);
      }

      match /private_events/{eventId} {
        allow read: if isOwner(userId);
        allow create: if isActiveOwner(userId)
          && request.resource.data.ownerId == userId;
        allow update: if isActiveOwner(userId)
          && request.resource.data.ownerId == resource.data.ownerId;
        allow delete: if isActiveOwner(userId);
      }

      match /personal_tasks/{taskId} {
        allow read: if isOwner(userId);
        allow write: if isActiveOwner(userId);
      }

      match /vehicles/{vehicleId} {
        allow read: if isOwner(userId);
        allow write: if isActiveOwner(userId);

        match /maintenances/{recordId} {
          allow read: if isOwner(userId);
          allow write: if isActiveOwner(userId);
        }

        match /fuel_logs/{logId} {
          allow read: if isOwner(userId);
          allow write: if isActiveOwner(userId);
        }
      }

      match /bills/{billId} {
        allow read: if isOwner(userId);
        allow write: if isActiveOwner(userId);
      }

      match /consents/{sourceId} {
        allow read: if isOwner(userId);
        allow delete: if isActiveOwner(userId);
        // Never allow plaintext partner/banking API tokens (`apiToken`) to be persisted in Cloud Firestore!
        allow create, update: if isActiveOwner(userId)
          && !('apiToken' in request.resource.data);
      }

      match /source_events/{eventKey} {
        allow read: if isOwner(userId);
        allow create: if isActiveOwner(userId)
          && request.resource.data.get('source', '') is string
          && !isServerSourceEventName(request.resource.data.get('source', ''));
        allow update: if isActiveOwner(userId)
          && !isServerSourceEventName(resource.data.get('source', ''))
          && request.resource.data.get('source', '') is string
          && !isServerSourceEventName(request.resource.data.get('source', ''));
        allow delete: if false;
      }

      match /source_claims/{claimId} {
        allow read: if isOwner(userId);
        allow create, update: if isActiveOwner(userId);
        allow delete: if isAccountDeletionActive(userId);
      }

      // NATIVE IN-APP BANK RECEIVING ACCOUNTS & DYNAMIC VIETQR PAYMENT ORDERS
      match /bank_accounts/{accountId} {
        allow read: if isOwner(userId);
        allow write: if isActiveOwner(userId);
      }

      match /payment_orders/{orderId} {
        allow read: if isOwner(userId);
        allow create: if isActiveOwner(userId)
          && request.resource.data.ownerId == userId
          && isPositiveInt(request.resource.data.amountMinor)
          && !isVerifiedByBankField(request.resource.data.get('verification', ''))
          && !(request.resource.data.get('status', '') is string && request.resource.data.get('status', '').lower() == 'verified');
        allow update: if isActiveOwner(userId)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.get('walletId', null) == resource.data.get('walletId', null)
          && request.resource.data.get('bankBin', null) == resource.data.get('bankBin', null)
          && request.resource.data.get('bankCode', null) == resource.data.get('bankCode', null)
          && request.resource.data.get('accountNumber', null) == resource.data.get('accountNumber', null)
          && request.resource.data.amountMinor == resource.data.amountMinor
          && request.resource.data.get('paymentCode', null) == resource.data.get('paymentCode', null)
          && request.resource.data.get('emvQrPayload', null) == resource.data.get('emvQrPayload', null)
          && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
          && !isVerifiedByBankField(request.resource.data.get('verification', ''))
          && !(request.resource.data.get('status', '') is string && request.resource.data.get('status', '').lower() == 'verified');
        allow delete: if isActiveOwner(userId);
      }

      // REAL-TIME BANKING CONNECTIONS, FINANCIAL NOTIFICATIONS, FCM DEVICES & PRIVACY PREFERENCES
      // Client can read own bank_connections or mark pendingRevocation, NEVER create or forge connected/granted!
      match /bank_connections/{connectionId} {
        allow read: if isOwner(userId);
        allow create: if false;
        allow update: if isActiveOwner(userId)
          && request.resource.data.ownerId == resource.data.ownerId
          && !('accountNumber' in request.resource.data)
          && !('apiToken' in request.resource.data)
          && request.resource.data.status == 'pendingRevocation'
          && request.resource.data.get('consentStatus', '') != 'granted'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'consentStatus',
            'revocationRequestedAt',
            'lastRevocationError',
            'updatedAt'
          ]);
        allow delete: if false;
      }

      // Real-time financial notifications: server Admin SDK writes verified pushes;
      // owner can read, mark read/dismiss (`isRead`, `readAt`, `dismissed`, `updatedAt`), delete during erasure,
      // or create explicit `isTestNotification == true` / `androidNotification`.
      match /financial_notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow create: if isActiveOwner(userId)
          && request.resource.data.ownerId == userId
          && (request.resource.data.isTestNotification == true || request.resource.data.sourceKind == 'androidNotification')
          && (
            request.resource.data.isTestNotification == true
            || !isVerifiedByBankField(request.resource.data.get('verificationStatus', ''))
          );
        allow update: if isActiveOwner(userId)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt', 'dismissed', 'updatedAt']);
        allow delete: if isActiveOwner(userId);
      }

      // Multi-device FCM registration strictly isolated per ownerId (T16, T20)
      match /devices/{deviceId} {
        allow read: if isOwner(userId);
        allow create, update: if isActiveOwner(userId)
          && request.resource.data.ownerId == userId
          && request.resource.data.deviceId == deviceId;
        allow delete: if isActiveOwner(userId);
      }

      match /notification_preferences/{prefId} {
        allow read: if isOwner(userId);
        allow create, update: if isActiveOwner(userId)
          && request.resource.data.ownerId == userId;
        allow delete: if isActiveOwner(userId);
      }

      // User-taught explainable merchant -> category mapping rules (Section 17)
      match /merchant_rules/{ruleId} {
        allow read: if isOwner(userId);
        allow write: if isActiveOwner(userId);
      }

      // OFFLINE FINANCIAL AI PERSONALIZATION, CORRECTIONS, DRAFTS & PREFERENCES (STRICT OWNER ISOLATION)
      match /ai_personalization_rules/{ruleId} {
        allow read: if isOwner(userId);
        allow write: if isActiveOwner(userId);
      }

      match /ai_category_corrections/{correctionId} {
        allow read: if isOwner(userId);
        allow write: if isActiveOwner(userId);
      }

      match /ai_pending_drafts/{draftId} {
        allow read: if isOwner(userId);
        allow write: if isActiveOwner(userId);
      }

      match /ai_preferences/{prefId} {
        allow read: if isOwner(userId);
        allow write: if isActiveOwner(userId);
      }

      // PERSONAL DOCUMENT VAULT (Contracts, Vehicle Papers, Insurance, IDs)
      match /documents/{docId} {
        allow read: if isOwner(userId);
        allow create: if isActiveOwner(userId)
          && request.resource.data.ownerId == userId;
        allow update: if isActiveOwner(userId)
          && request.resource.data.ownerId == resource.data.ownerId;
        allow delete: if isActiveOwner(userId);
      }

      // PRO UTILITIES SUITE (Subscriptions/Warranties, Habits/Focus, Gift Ledger, Travel Packing)
      match /subscriptions_warranties/{itemId} {
        allow read: if isOwner(userId);
        allow write: if isActiveOwner(userId);
      }

      match /habits/{habitId} {
        allow read: if isOwner(userId);
        allow write: if isActiveOwner(userId);
      }

      match /wellness_daily/{dayKey} {
        allow read: if isOwner(userId);
        allow write: if isActiveOwner(userId);
      }

      match /gift_ledger/{entryId} {
        allow read: if isOwner(userId);
        allow write: if isActiveOwner(userId);
      }

      match /packing_items/{itemId} {
        allow read: if isOwner(userId);
        allow write: if isActiveOwner(userId);
      }

      // 360° DAILY LIFE SUPER APP SUITE (Hydration Preferences, Kitchen/Groceries, Home/EVN Utilities, Smart Notes)
      match /daily_preferences/{prefId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isActiveOwner(userId);
      }

      // Legacy health/medical cleanup paths: owner read & delete ONLY (new client writes blocked for Play compliance)
      match /medications/{medId} {
        allow read: if isOwner(userId);
        allow delete: if isActiveOwner(userId);
        allow create, update: if false;
      }

      match /health_logs/{logId} {
        allow read: if isOwner(userId);
        allow delete: if isActiveOwner(userId);
        allow create, update: if false;
      }

      match /medical_profiles/{profileId} {
        allow read: if isOwner(userId);
        allow delete: if isActiveOwner(userId);
        allow create, update: if false;
      }

      match /grocery_items/{itemId} {
        allow read: if isOwner(userId);
        allow write: if isActiveOwner(userId);
      }

      match /meal_plans/{dayKey} {
        allow read: if isOwner(userId);
        allow write: if isActiveOwner(userId);
      }

      match /utility_readings/{readingId} {
        allow read: if isOwner(userId);
        allow write: if isActiveOwner(userId);
      }

      match /home_contracts/{contractId} {
        allow read: if isOwner(userId);
        allow write: if isActiveOwner(userId);
      }

      match /life_notes/{noteId} {
        allow read: if isOwner(userId);
        allow write: if isActiveOwner(userId);
      }
    }

    // =========================================================================
    // 2. FAMILY INVITE CODES — GET BY EXACT CODE ONLY, ZERO RAW PII & ATOMIC CONSUMPTION
    // =========================================================================
    match /family_invites/{inviteCode} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn()
        && isFamilyManager(request.resource.data.familyId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.inviteCode == inviteCode
        && !('inviteeContact' in request.resource.data)
        && !('email' in request.resource.data)
        && !('phone' in request.resource.data)
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.maxUses is int
        && request.resource.data.maxUses >= 1
        && request.resource.data.usedCount == 0
        && request.resource.data.get('revoked', false) == false
        && request.resource.data.get('status', 'active') == 'active'
        && (
          !isTargetedInvite(request.resource.data)
          || (
            request.resource.data.maxUses == 1
            && (
              hasNonEmptyString(request.resource.data, 'inviteeUid')
              || hasNonEmptyString(request.resource.data, 'inviteeEmail')
              || hasNonEmptyString(request.resource.data, 'intendedRecipientHash')
            )
          )
        );
      // (a) Family Owner/Admin manages/revokes invite metadata without exposing contact PII or forging usage/consumption, OR
      // (b) Non-member joining atomically consumes exactly 1 slot alongside families/{familyId} update
      allow update: if isSignedIn() && (
        (
          isFamilyManager(resource.data.familyId)
          && request.resource.data.familyId == resource.data.familyId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.inviteCode == resource.data.inviteCode
          && request.resource.data.get('usedCount', 0) == resource.data.get('usedCount', 0)
          && request.resource.data.get('consumedBy', null) == resource.data.get('consumedBy', null)
          && request.resource.data.get('inviteeUid', null) == resource.data.get('inviteeUid', null)
          && request.resource.data.get('inviteeEmail', null) == resource.data.get('inviteeEmail', null)
          && request.resource.data.get('intendedRecipientHash', null) == resource.data.get('intendedRecipientHash', null)
          && !('inviteeContact' in request.resource.data)
          && !('email' in request.resource.data)
          && !('phone' in request.resource.data)
        )
        || (
          resource.data.get('revoked', false) != true
          && resource.data.get('status', 'active') == 'active'
          && resource.data.expiresAt > request.time
          && isAuthorizedForInvite(resource.data)
          && request.resource.data.usedCount is int
          && request.resource.data.usedCount == resource.data.get('usedCount', 0) + 1
          && request.resource.data.usedCount <= resource.data.get('maxUses', 1)
          && request.resource.data.consumedBy == request.auth.uid
          && request.resource.data.familyId == resource.data.familyId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.inviteCode == resource.data.inviteCode
          && !('inviteeContact' in request.resource.data)
          && !('email' in request.resource.data)
          && !('phone' in request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount', 'consumedBy', 'consumedAt', 'status', 'updatedAt'])
          && (
            (request.resource.data.usedCount == resource.data.get('maxUses', 1) && request.resource.data.get('status', 'consumed') == 'consumed')
            || (request.resource.data.usedCount < resource.data.get('maxUses', 1) && request.resource.data.get('status', 'active') == 'active')
          )
          && !(request.auth.uid in get(/databases/$(database)/documents/families/$(resource.data.familyId)).data.memberIds)
          && !(request.auth.uid in get(/databases/$(database)/documents/families/$(resource.data.familyId)).data.get('bannedUserIds', []))
          && existsAfter(/databases/$(database)/documents/families/$(resource.data.familyId))
          && getAfter(/databases/$(database)/documents/families/$(resource.data.familyId)).data.memberIds.hasAll([request.auth.uid])
          && getAfter(/databases/$(database)/documents/families/$(resource.data.familyId)).data.memberIds.size() == get(/databases/$(database)/documents/families/$(resource.data.familyId)).data.memberIds.size() + 1
          && getAfter(/databases/$(database)/documents/families/$(resource.data.familyId)).data.memberRoles[request.auth.uid] == 'member'
          && getAfter(/databases/$(database)/documents/families/$(resource.data.familyId)).data.lastJoinedInviteCode == inviteCode
        )
      );
      allow delete: if isSignedIn() && isFamilyManager(resource.data.familyId);
    }

    // =========================================================================
    // 3. HOUSEHOLD SHARED SPACE — ENFORCED RBAC & NO SELF-ROLE ESCALATION
    // =========================================================================
    match /families/{familyId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.memberRoles.keys().hasOnly([request.auth.uid])
        && request.resource.data.memberRoles[request.auth.uid] == 'owner';

      allow update: if isSignedIn() && (
        // 1a. Owner manages family metadata & member roles while keeping creator & own owner role intact (F03 / AUD-005)
        (
          request.auth.uid in resource.data.memberRoles
          && resource.data.memberRoles[request.auth.uid] == 'owner'
          && request.resource.data.createdBy == resource.data.createdBy
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.memberRoles[request.auth.uid] == 'owner'
          && request.resource.data.memberRoles[resource.data.createdBy] == 'owner'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'spaceType', 'pendingInvites', 'memberIds', 'memberRoles', 'memberNames', 'lastRemovedMemberId', 'bannedUserIds', 'updatedAt'])
        )
        // 1b. Admin manages invites/metadata or removes ONLY a plain 'member'; NEVER alters owner/admin roles or escalates self (F03 / SEC-02 / AUD-005)
        || (
          request.auth.uid in resource.data.memberRoles
          && resource.data.memberRoles[request.auth.uid] == 'admin'
          && request.resource.data.createdBy == resource.data.createdBy
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.memberRoles[request.auth.uid] == 'admin'
          && request.resource.data.memberRoles[resource.data.createdBy] == resource.data.memberRoles[resource.data.createdBy]
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'spaceType', 'pendingInvites', 'memberIds', 'memberRoles', 'memberNames', 'lastRemovedMemberId', 'bannedUserIds', 'updatedAt'])
          && (
            (
              request.resource.data.memberIds == resource.data.memberIds
              && request.resource.data.memberRoles == resource.data.memberRoles
            )
            || (
              request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
              && resource.data.memberIds.hasAll(request.resource.data.memberIds)
              && request.resource.data.lastRemovedMemberId is string
              && resource.data.memberRoles[request.resource.data.lastRemovedMemberId] == 'member'
              && !(request.resource.data.lastRemovedMemberId in request.resource.data.memberIds)
              && unchangedMapExceptSelfLeave(resource.data.memberRoles, request.resource.data.memberRoles, request.resource.data.lastRemovedMemberId)
            )
          )
        )
        // 2. Member leaves voluntarily: strictly isolated to removing own UID; all other members & fields immutable (F02 / SEC-01)
        || (
          request.auth.uid in resource.data.memberIds
          && !(request.auth.uid in request.resource.data.memberIds)
          && (resource.data.memberRoles[request.auth.uid] != 'owner' || request.resource.data.memberIds.size() == 0)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
          && resource.data.memberIds.hasAll(request.resource.data.memberIds)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'memberRoles', 'memberNames', 'updatedAt'])
          && unchangedMapExceptSelfLeave(resource.data.memberRoles, request.resource.data.memberRoles, request.auth.uid)
          && (!('memberNames' in request.resource.data) || unchangedMapExceptSelfLeave(resource.data.get('memberNames', {}), request.resource.data.memberNames, request.auth.uid))
        )
        // 3. New user joins with a valid, UNEXPIRED, UNREVOKED, UNCONSUMED invite code ONLY as 'member'; atomic slot consumption & ban block enforced (FIX-002 / FIX-003 / SEC-03 / AUD-005)
        || (
          !(request.auth.uid in resource.data.memberIds)
          && !(request.auth.uid in resource.data.get('bannedUserIds', []))
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.memberRoles[request.auth.uid] == 'member'
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'memberRoles', 'memberNames', 'pendingInvites', 'lastJoinedInviteCode', 'updatedAt'])
          && unchangedMapExceptSelfJoin(resource.data.memberRoles, request.resource.data.memberRoles, request.auth.uid)
          && (!('memberNames' in request.resource.data) || unchangedMapExceptSelfJoin(resource.data.get('memberNames', {}), request.resource.data.memberNames, request.auth.uid))
          && (
            !('pendingInvites' in request.resource.data)
            || (
              request.resource.data.pendingInvites.diff(resource.data.get('pendingInvites', {})).addedKeys().size() == 0
              && request.resource.data.pendingInvites.diff(resource.data.get('pendingInvites', {})).changedKeys().size() == 0
              && request.resource.data.pendingInvites.diff(resource.data.get('pendingInvites', {})).removedKeys().hasOnly([request.resource.data.lastJoinedInviteCode])
            )
          )
          && request.resource.data.lastJoinedInviteCode is string
          && exists(/databases/$(database)/documents/family_invites/$(request.resource.data.lastJoinedInviteCode))
          && existsAfter(/databases/$(database)/documents/family_invites/$(request.resource.data.lastJoinedInviteCode))
          && get(/databases/$(database)/documents/family_invites/$(request.resource.data.lastJoinedInviteCode)).data.familyId == familyId
          && get(/databases/$(database)/documents/family_invites/$(request.resource.data.lastJoinedInviteCode)).data.expiresAt > request.time
          && get(/databases/$(database)/documents/family_invites/$(request.resource.data.lastJoinedInviteCode)).data.get('revoked', false) != true
          && get(/databases/$(database)/documents/family_invites/$(request.resource.data.lastJoinedInviteCode)).data.get('status', 'active') == 'active'
          && isAuthorizedForInvite(get(/databases/$(database)/documents/family_invites/$(request.resource.data.lastJoinedInviteCode)).data)
          && get(/databases/$(database)/documents/family_invites/$(request.resource.data.lastJoinedInviteCode)).data.get('usedCount', 0) < get(/databases/$(database)/documents/family_invites/$(request.resource.data.lastJoinedInviteCode)).data.get('maxUses', 1)
          && getAfter(/databases/$(database)/documents/family_invites/$(request.resource.data.lastJoinedInviteCode)).data.get('usedCount', 0) == get(/databases/$(database)/documents/family_invites/$(request.resource.data.lastJoinedInviteCode)).data.get('usedCount', 0) + 1
          && getAfter(/databases/$(database)/documents/family_invites/$(request.resource.data.lastJoinedInviteCode)).data.consumedBy == request.auth.uid
        )
      );

      allow delete: if false;

      // AUD-001: Family Shared Fund — Zero-start balance, immutable audit trail, atomic contributions & 9-state expense lifecycle
      match /funds/{fundId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId)
          && request.resource.data.id == fundId
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.familyId == familyId
          && request.resource.data.balanceMinor == 0
          && request.resource.data.targetAmountMinor is int
          && request.resource.data.targetAmountMinor >= 0;
        allow update: if isFamilyMember(familyId)
          && request.resource.data.get('id', fundId) == resource.data.get('id', fundId)
          && request.resource.data.get('ownerId', resource.data.ownerId) == resource.data.ownerId
          && request.resource.data.familyId == resource.data.familyId
          && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
          && request.resource.data.balanceMinor is int
          && request.resource.data.balanceMinor >= 0
          && (
            (
              request.resource.data.balanceMinor == resource.data.balanceMinor
              && (isFamilyManager(familyId) || resource.data.ownerId == request.auth.uid)
            )
            || (
              request.resource.data.balanceMinor != resource.data.balanceMinor
              && 'lastAuditId' in request.resource.data
              && request.resource.data.lastAuditId is string
              && request.resource.data.lastAuditId.size() > 0
              && !exists(/databases/$(database)/documents/families/$(familyId)/funds/$(fundId)/fund_audits/$(request.resource.data.lastAuditId))
              && existsAfter(/databases/$(database)/documents/families/$(familyId)/funds/$(fundId)/fund_audits/$(request.resource.data.lastAuditId))
              && getAfter(/databases/$(database)/documents/families/$(familyId)/funds/$(fundId)/fund_audits/$(request.resource.data.lastAuditId)).data.previousBalanceMinor == resource.data.balanceMinor
              && getAfter(/databases/$(database)/documents/families/$(familyId)/funds/$(fundId)/fund_audits/$(request.resource.data.lastAuditId)).data.newBalanceMinor == request.resource.data.balanceMinor
              && getAfter(/databases/$(database)/documents/families/$(familyId)/funds/$(fundId)/fund_audits/$(request.resource.data.lastAuditId)).data.previousBalanceMinor
                + getAfter(/databases/$(database)/documents/families/$(familyId)/funds/$(fundId)/fund_audits/$(request.resource.data.lastAuditId)).data.deltaMinor
                == getAfter(/databases/$(database)/documents/families/$(familyId)/funds/$(fundId)/fund_audits/$(request.resource.data.lastAuditId)).data.newBalanceMinor
              && 'lastEventType' in request.resource.data
              && 'lastEventId' in request.resource.data
              && request.resource.data.lastEventId is string
              && request.resource.data.lastEventId.size() > 0
              && (
                (
                  request.resource.data.lastEventType == 'contribution'
                  && !exists(/databases/$(database)/documents/families/$(familyId)/funds/$(fundId)/contributions/$(request.resource.data.lastEventId))
                  && existsAfter(/databases/$(database)/documents/families/$(familyId)/funds/$(fundId)/contributions/$(request.resource.data.lastEventId))
                  && getAfter(/databases/$(database)/documents/families/$(familyId)/funds/$(fundId)/fund_audits/$(request.resource.data.lastAuditId)).data.deltaMinor
                    == getAfter(/databases/$(database)/documents/families/$(familyId)/funds/$(fundId)/contributions/$(request.resource.data.lastEventId)).data.amountMinor
                )
                || (
                  request.resource.data.lastEventType == 'expense_executed'
                  && isFamilyManager(familyId)
                  && exists(/databases/$(database)/documents/families/$(familyId)/funds/$(fundId)/expenses/$(request.resource.data.lastEventId))
                  && get(/databases/$(database)/documents/families/$(familyId)/funds/$(fundId)/expenses/$(request.resource.data.lastEventId)).data.status in ['approved', 'pending']
                  && getAfter(/databases/$(database)/documents/families/$(familyId)/funds/$(fundId)/expenses/$(request.resource.data.lastEventId)).data.status == 'executed'
                  && getAfter(/databases/$(database)/documents/families/$(familyId)/funds/$(fundId)/fund_audits/$(request.resource.data.lastAuditId)).data.deltaMinor
                    == -getAfter(/databases/$(database)/documents/families/$(familyId)/funds/$(fundId)/expenses/$(request.resource.data.lastEventId)).data.amountMinor
                )
                || (
                  request.resource.data.lastEventType == 'expense_reversed'
                  && isFamilyManager(familyId)
                  && exists(/databases/$(database)/documents/families/$(familyId)/funds/$(fundId)/expenses/$(request.resource.data.lastEventId))
                  && get(/databases/$(database)/documents/families/$(familyId)/funds/$(fundId)/expenses/$(request.resource.data.lastEventId)).data.status in ['executed', 'disputed']
                  && getAfter(/databases/$(database)/documents/families/$(familyId)/funds/$(fundId)/expenses/$(request.resource.data.lastEventId)).data.status == 'reversed'
                  && getAfter(/databases/$(database)/documents/families/$(familyId)/funds/$(fundId)/fund_audits/$(request.resource.data.lastAuditId)).data.deltaMinor
                    == get(/databases/$(database)/documents/families/$(familyId)/funds/$(fundId)/expenses/$(request.resource.data.lastEventId)).data.amountMinor
                )
              )
            )
          );
        allow delete: if isFamilyManager(familyId) && resource.data.balanceMinor == 0;

        match /fund_audits/{auditId} {
          allow read: if isFamilyMember(familyId);
          allow create: if isFamilyMember(familyId)
            && request.resource.data.actorId == request.auth.uid
            && request.resource.data.fundId == fundId
            && request.resource.data.previousBalanceMinor is int
            && request.resource.data.deltaMinor is int
            && request.resource.data.newBalanceMinor == request.resource.data.previousBalanceMinor + request.resource.data.deltaMinor;
          allow update, delete: if false;
        }

        match /contributions/{contribId} {
          allow read: if isFamilyMember(familyId);
          allow create: if isFamilyMember(familyId)
            && request.resource.data.get('id', contribId) == contribId
            && request.resource.data.contributorId == request.auth.uid
            && isPositiveInt(request.resource.data.amountMinor)
            && getAfter(/databases/$(database)/documents/families/$(familyId)/funds/$(fundId)).data.lastEventType == 'contribution'
            && getAfter(/databases/$(database)/documents/families/$(familyId)/funds/$(fundId)).data.lastEventId == contribId
            && getAfter(/databases/$(database)/documents/families/$(familyId)/funds/$(fundId)).data.balanceMinor
              == get(/databases/$(database)/documents/families/$(familyId)/funds/$(fundId)).data.balanceMinor + request.resource.data.amountMinor;
          allow update, delete: if false;
        }

        match /expenses/{expId} {
          allow read: if isFamilyMember(familyId);
          allow create: if isFamilyMember(familyId)
            && request.resource.data.get('id', expId) == expId
            && request.resource.data.get('fundId', fundId) == fundId
            && request.resource.data.requesterId == request.auth.uid
            && isPositiveInt(request.resource.data.amountMinor)
            && request.resource.data.status in ['draft', 'pending_approval', 'pending']
            && !('decidedBy' in request.resource.data)
            && !('executedBy' in request.resource.data);
          allow update: if isFamilyMember(familyId)
            && request.resource.data.get('id', expId) == resource.data.get('id', expId)
            && request.resource.data.get('fundId', fundId) == resource.data.get('fundId', fundId)
            && request.resource.data.requesterId == resource.data.requesterId
            && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
            && (
              (
                resource.data.status == 'draft'
                && isPositiveInt(request.resource.data.amountMinor)
              )
              || (
                request.resource.data.amountMinor == resource.data.amountMinor
                && request.resource.data.get('title', '') == resource.data.get('title', '')
              )
            )
            && (
              // Requester: draft -> draft|pending_approval|cancelled, or pending_approval|pending -> cancelled
              (
                resource.data.requesterId == request.auth.uid
                && !('decidedBy' in request.resource.data)
                && !('executedBy' in request.resource.data)
                && (
                  (resource.data.status == 'draft' && request.resource.data.status in ['draft', 'pending_approval', 'cancelled'])
                  || (resource.data.status in ['pending_approval', 'pending'] && request.resource.data.status == 'cancelled')
                )
              )
              // Manager transitions: approve/reject (with separation-of-duties), execute, reconcile, reverse
              || (
                isFamilyManager(familyId)
                && (
                  (
                    resource.data.status in ['pending_approval', 'pending']
                    && request.resource.data.status in ['approved', 'rejected']
                    && request.resource.data.decidedBy == request.auth.uid
                    && !('executedBy' in request.resource.data)
                    && (resource.data.requesterId != request.auth.uid || familyDoc(familyId).data.memberIds.size() == 1)
                  )
                  || (
                    resource.data.status == 'approved'
                    && request.resource.data.status == 'executed'
                    && request.resource.data.executedBy == request.auth.uid
                    && request.resource.data.get('decidedBy', null) == resource.data.get('decidedBy', null)
                    && getAfter(/databases/$(database)/documents/families/$(familyId)/funds/$(fundId)).data.lastEventType == 'expense_executed'
                    && getAfter(/databases/$(database)/documents/families/$(familyId)/funds/$(fundId)).data.lastEventId == expId
                    && getAfter(/databases/$(database)/documents/families/$(familyId)/funds/$(fundId)).data.balanceMinor
                      == get(/databases/$(database)/documents/families/$(familyId)/funds/$(fundId)).data.balanceMinor - resource.data.amountMinor
                  )
                  || (
                    resource.data.status == 'executed'
                    && request.resource.data.status == 'reconciled'
                    && request.resource.data.get('decidedBy', null) == resource.data.get('decidedBy', null)
                    && request.resource.data.get('executedBy', null) == resource.data.get('executedBy', null)
                  )
                  || (
                    resource.data.status in ['executed', 'approved', 'disputed']
                    && request.resource.data.status == 'reversed'
                    && (
                      resource.data.status == 'approved'
                      || (
                        resource.data.status in ['executed', 'disputed']
                        && getAfter(/databases/$(database)/documents/families/$(familyId)/funds/$(fundId)).data.lastEventType == 'expense_reversed'
                        && getAfter(/databases/$(database)/documents/families/$(familyId)/funds/$(fundId)).data.lastEventId == expId
                        && getAfter(/databases/$(database)/documents/families/$(familyId)/funds/$(fundId)).data.balanceMinor
                          == get(/databases/$(database)/documents/families/$(familyId)/funds/$(fundId)).data.balanceMinor + resource.data.amountMinor
                      )
                    )
                  )
                )
              )
              // Any member: executed -> disputed
              || (
                resource.data.status == 'executed'
                && request.resource.data.status == 'disputed'
                && request.resource.data.disputedBy == request.auth.uid
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'disputedBy', 'disputedAt', 'disputeReason', 'updatedAt'])
              )
            );
          allow delete: if false;
        }
      }

      match /shared_events/{eventId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId)
          && request.resource.data.ownerId == request.auth.uid;
        allow update: if isFamilyMember(familyId)
          && request.resource.data.ownerId == resource.data.ownerId
          && (resource.data.ownerId == request.auth.uid || isFamilyManager(familyId));
        allow delete: if isFamilyMember(familyId)
          && (resource.data.ownerId == request.auth.uid || isFamilyManager(familyId));
      }

      match /availability/{slotId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId)
          && request.resource.data.ownerId == request.auth.uid;
        allow update: if isFamilyMember(familyId)
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId;
        allow delete: if isFamilyMember(familyId)
          && (resource.data.ownerId == request.auth.uid || isFamilyManager(familyId));
      }

      match /tasks/{taskId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId)
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if isFamilyMember(familyId)
          && request.resource.data.createdBy == resource.data.createdBy
          && (
            request.auth.uid == resource.data.createdBy
            || isFamilyManager(familyId)
            || (
              request.auth.uid == resource.data.assigneeId
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'responseNote', 'updatedAt'])
            )
          );
        allow delete: if isFamilyMember(familyId)
          && (resource.data.createdBy == request.auth.uid || isFamilyManager(familyId));
      }

      match /vehicles/{vehicleId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId)
          && request.resource.data.ownerId == request.auth.uid;
        allow update: if isFamilyMember(familyId)
          && request.resource.data.ownerId == resource.data.ownerId;
        allow delete: if isFamilyMember(familyId)
          && (resource.data.ownerId == request.auth.uid || isFamilyManager(familyId));

        match /maintenances/{recordId} {
          allow read, create: if isFamilyMember(familyId);
          allow delete: if isFamilyMember(familyId)
            && (
              get(/databases/$(database)/documents/families/$(familyId)/vehicles/$(vehicleId)).data.ownerId == request.auth.uid
              || isFamilyManager(familyId)
            );
        }

        match /fuel_logs/{logId} {
          allow read, create: if isFamilyMember(familyId);
          allow delete: if isFamilyMember(familyId)
            && (
              get(/databases/$(database)/documents/families/$(familyId)/vehicles/$(vehicleId)).data.ownerId == request.auth.uid
              || isFamilyManager(familyId)
            );
        }
      }

      match /bills/{billId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId)
          && request.resource.data.ownerId == request.auth.uid;
        allow update: if isFamilyMember(familyId)
          && request.resource.data.ownerId == resource.data.ownerId;
        allow delete: if isFamilyMember(familyId)
          && (resource.data.ownerId == request.auth.uid || isFamilyManager(familyId));
      }

      match /shopping_items/{itemId} {
        allow read, create, update, delete: if isFamilyMember(familyId);
      }

      // SHARED FAMILY DOCUMENT VAULT (Bills & Contracts, Vehicle Papers, Insurance, Important Docs)
      match /documents/{docId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId)
          && request.resource.data.familyId == familyId
          && request.resource.data.uploadedBy == request.auth.uid;
        allow update: if isFamilyMember(familyId)
          && request.resource.data.familyId == resource.data.familyId
          && (resource.data.uploadedBy == request.auth.uid || isFamilyManager(familyId))
          && request.resource.data.uploadedBy == resource.data.uploadedBy;
        allow delete: if isFamilyManager(familyId)
          || (isFamilyMember(familyId) && resource.data.uploadedBy == request.auth.uid);
      }

      // SHARED BILL SPLITTING (F05 / AUD-003: Real member shares, sum == totalAmountMinor invariant up to 20 members, locked payer/creator authority & settled deletion lock)
      match /split_bills/{billId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId)
          && request.resource.data.get('id', billId) == billId
          && request.resource.data.familyId == familyId
          && isPositiveInt(request.resource.data.totalAmountMinor)
          && request.resource.data.paidByUserId is string
          && request.resource.data.paidByUserId in familyDoc(familyId).data.memberIds
          && (request.resource.data.paidByUserId == request.auth.uid || isFamilyManager(familyId))
          && hasValidSplitBillShares(request.resource.data, familyId)
          && request.resource.data.get('status', 'open') in ['open', 'pending_confirmation'];
        allow update: if isFamilyMember(familyId)
          && (resource.data.paidByUserId == request.auth.uid || isFamilyManager(familyId))
          && resource.data.get('status', 'open') != 'locked'
          && resource.data.get('status', 'open') != 'settled'
          && request.resource.data.get('id', billId) == resource.data.get('id', billId)
          && request.resource.data.familyId == resource.data.familyId
          && request.resource.data.paidByUserId == resource.data.paidByUserId
          && isPositiveInt(request.resource.data.totalAmountMinor)
          && request.resource.data.get('status', 'open') in ['open', 'pending_confirmation', 'settled', 'locked']
          && hasValidSplitBillShares(request.resource.data, familyId);
        allow delete: if isFamilyMember(familyId)
          && resource.data.get('status', 'open') == 'open'
          && (resource.data.paidByUserId == request.auth.uid || isFamilyManager(familyId));
      }

      // TWO-STEP DEBT SETTLEMENT CONSENT REQUESTS (F04 / AUD-002: Debtor initiates 'pending', Creditor confirms/rejects atomically)
      match /settlement_requests/{requestId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId)
          && request.resource.data.familyId == familyId
          && isPositiveInt(request.resource.data.amountMinor)
          && request.resource.data.fromUserId is string
          && request.resource.data.toUserId is string
          && request.resource.data.fromUserId != request.resource.data.toUserId
          && request.resource.data.fromUserId == request.auth.uid
          && request.resource.data.fromUserId in familyDoc(familyId).data.memberIds
          && request.resource.data.toUserId in familyDoc(familyId).data.memberIds
          && request.resource.data.status == 'pending';
        allow update: if isFamilyMember(familyId)
          && resource.data.status == 'pending'
          && request.auth.uid == resource.data.toUserId
          && request.resource.data.confirmedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'confirmedBy', 'confirmedAt', 'disputeReason', 'settlementId'])
          && request.resource.data.status in ['confirmed', 'rejected']
          && (
            request.resource.data.status == 'rejected'
            || (
              request.resource.data.status == 'confirmed'
              && request.resource.data.get('settlementId', '') == 'stl_req_' + requestId
              && existsAfter(/databases/$(database)/documents/families/$(familyId)/settlements/$('stl_req_' + requestId))
            )
          );
        allow delete: if false;
      }

      // DEBT SETTLEMENT LEDGER (F04 / SEC-04 / AUD-002: Append-only; forbids unilateral debtor creation & unverified bank_transfer forgery)
      match /settlements/{settlementId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId)
          && request.resource.data.get('id', settlementId) == settlementId
          && request.resource.data.familyId == familyId
          && isPositiveInt(request.resource.data.amountMinor)
          && request.resource.data.fromUserId is string
          && request.resource.data.toUserId is string
          && request.resource.data.fromUserId != request.resource.data.toUserId
          && request.resource.data.toUserId in familyDoc(familyId).data.memberIds
          && (
            // (a) Creditor confirming direct receipt (NOT reversal, NOT settlementRequestId) from a real member
            (
              request.auth.uid == request.resource.data.toUserId
              && !('reversalOfId' in request.resource.data)
              && !('settlementRequestId' in request.resource.data)
              && request.resource.data.fromUserId in familyDoc(familyId).data.memberIds
            )
            // (b) Atomic settlement_requests confirmation by creditor
            || (
              'settlementRequestId' in request.resource.data
              && request.resource.data.settlementRequestId is string
              && !('reversalOfId' in request.resource.data)
              && settlementId == 'stl_req_' + request.resource.data.settlementRequestId
              && exists(/databases/$(database)/documents/families/$(familyId)/settlement_requests/$(request.resource.data.settlementRequestId))
              && get(/databases/$(database)/documents/families/$(familyId)/settlement_requests/$(request.resource.data.settlementRequestId)).data.status == 'pending'
              && getAfter(/databases/$(database)/documents/families/$(familyId)/settlement_requests/$(request.resource.data.settlementRequestId)).data.status == 'confirmed'
              && request.auth.uid == get(/databases/$(database)/documents/families/$(familyId)/settlement_requests/$(request.resource.data.settlementRequestId)).data.toUserId
              && request.resource.data.fromUserId == get(/databases/$(database)/documents/families/$(familyId)/settlement_requests/$(request.resource.data.settlementRequestId)).data.fromUserId
              && request.resource.data.toUserId == get(/databases/$(database)/documents/families/$(familyId)/settlement_requests/$(request.resource.data.settlementRequestId)).data.toUserId
              && request.resource.data.amountMinor == get(/databases/$(database)/documents/families/$(familyId)/settlement_requests/$(request.resource.data.settlementRequestId)).data.amountMinor
            )
            // (c) Deterministic single reversal by creditor or family manager
            || (
              'reversalOfId' in request.resource.data
              && request.resource.data.reversalOfId is string
              && settlementId == 'rev_' + request.resource.data.reversalOfId
              && exists(/databases/$(database)/documents/families/$(familyId)/settlements/$(request.resource.data.reversalOfId))
              && !('reversalOfId' in get(/databases/$(database)/documents/families/$(familyId)/settlements/$(request.resource.data.reversalOfId)).data)
              && request.resource.data.fromUserId == get(/databases/$(database)/documents/families/$(familyId)/settlements/$(request.resource.data.reversalOfId)).data.toUserId
              && request.resource.data.toUserId == get(/databases/$(database)/documents/families/$(familyId)/settlements/$(request.resource.data.reversalOfId)).data.fromUserId
              && request.resource.data.amountMinor == get(/databases/$(database)/documents/families/$(familyId)/settlements/$(request.resource.data.reversalOfId)).data.amountMinor
              && (
                request.auth.uid == get(/databases/$(database)/documents/families/$(familyId)/settlements/$(request.resource.data.reversalOfId)).data.toUserId
                || isFamilyManager(familyId)
              )
            )
          );
        allow update, delete: if false;
      }
    }

    // =========================================================================
    // 4. APP RELEASE MANIFEST (OTA IN-APP UPDATE METADATA — SIGNED-IN READ ONLY)
    // =========================================================================
    match /app_config/{configId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // =========================================================================
    // 5. SERVER-ONLY BANKING COLLECTIONS (ADMIN SDK ONLY — ZERO CLIENT ACCESS)
    // =========================================================================
    match /server_bank_connections/{connectionId} {
      allow read, write: if false;
    }

    match /server_bank_account_claims/{claimId} {
      allow read, write: if false;
    }

    match /sepay_webhook_inbox/{providerEventKey} {
      allow read, write: if false;
    }

    match /notification_outbox/{notificationId} {
      allow read, write: if false;
    }

    match /bank_reconciliation_jobs/{jobId} {
      allow read, write: if false;
    }

    match /family_invite_rate_limits/{userId} {
      allow read, write: if false;
    }

    match /account_deletion_jobs/{userId} {
      allow read, write: if false;
    }

    match /account_deletion_tombstones/{userId} {
      allow read, write: if false;
    }

    match /api_rate_limits/{limitId} {
      allow read, write: if false;
    }

    // DEFAULT DENY ALL OTHER PATHS
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
