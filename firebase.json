{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/webhooks/sepay",
        "function": {
          "functionId": "sepayWebhook",
          "region": "asia-southeast1"
        }
      }
    ]
  },
  "emulators": {
    "auth": {
      "host": "0.0.0.0",
      "port": 9199
    },
    "firestore": {
      "host": "0.0.0.0",
      "port": 8188
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 5001
    },
    "ui": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 4100
    },
    "singleProjectMode": true
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "life-os-vn-2026",
          "appId": "1:913180533540:android:156f7d8732017879a289b1",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "life-os-vn-2026",
          "appId": "1:913180533540:ios:bf80d67a365ab61aa289b1",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "life-os-vn-2026",
          "configurations": {
            "android": "1:913180533540:android:156f7d8732017879a289b1",
            "ios": "1:913180533540:ios:bf80d67a365ab61aa289b1",
            "web": "1:913180533540:web:a46bda8b9162d8bfa289b1"
          }
        }
      }
    }
  }
}
