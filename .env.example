# ==============================================================================
# LIFE OS — SAFE DEVELOPMENT CONFIGURATION TEMPLATE (.env.example)
# Truyền vào Flutter qua `--dart-define` hoặc chạy `flutterfire configure`.
# TUYỆT ĐỐI KHÔNG đưa khóa bí mật máy chủ (SePay secret, Admin key) vào ứng dụng Flutter.
# ==============================================================================

# 1. Chế độ Local Emulator mặc định (không tốn phí, không cần khóa Cloud thật)
USE_FIREBASE_EMULATOR=true
FIREBASE_EMULATOR_HOST=127.0.0.1
FIREBASE_PROJECT_ID=demo-life-os

# 2. Cấu hình Cloud Firebase Spark (điền sau khi chạy `flutterfire configure`)
FIREBASE_API_KEY=replace_with_flutterfire_generated_public_api_key
FIREBASE_APP_ID=replace_with_flutterfire_generated_app_id
FIREBASE_MESSAGING_SENDER_ID=replace_with_sender_id
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
